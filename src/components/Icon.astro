---
// Stroke icons for chrome (nav, topbar, section heads). Content emojis
// (campaign / entry / theme) stay as authored — these replace the generic
// UI pictograms only.
export type IconName =
  | 'book'
  | 'menu'
  | 'sun'
  | 'moon'
  | 'circle-half'
  | 'search'
  | 'tag'
  | 'clock'
  | 'scroll'
  | 'person'
  | 'masks'
  | 'bolt'
  | 'map'
  | 'chevron-down'
  | 'close'
  | 'file'
  | 'medal'
  | 'flag'

interface Props {
  name: IconName | string
  class?: string
}

const PATHS: Record<string, string> = {
  book: '<path d="M12 5v15"/><path d="M6 7.2C6 6 7 5 8.3 5H12"/><path d="M18 7.2C18 6 17 5 15.7 5H12"/><path d="M6 7.2v10.3C6 19 7 20 8.3 20H12"/><path d="M18 7.2v10.3C18 19 17 20 15.7 20H12"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  sun: '<circle cx="12" cy="12" r="3.6"/><path d="M12 3.2v2M12 18.8v2M4.4 4.4l1.4 1.4M18.2 18.2l1.4 1.4M3.2 12h2M18.8 12h2M4.4 19.6l1.4-1.4M18.2 5.8l1.4-1.4"/>',
  moon: '<path d="M16.2 4.8A7.6 7.6 0 1 1 5.4 16.4 6.2 6.2 0 0 0 16.2 4.8z"/>',
  'circle-half':
    '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none"/>',
  search: '<circle cx="11" cy="11" r="6.2"/><path d="M15.8 15.8 20 20"/>',
  tag: '<path d="M3.8 12.2V5.6A1.6 1.6 0 0 1 5.4 4h6.2l8 8-7.2 7.2L3.8 12.2z"/><circle cx="8" cy="8" r="1.1" fill="currentColor" stroke="none"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.4l3 1.8"/>',
  scroll:
    '<path d="M7.2 7A2.2 2.2 0 0 1 9.4 4.8H18v12.4a1.8 1.8 0 0 1-1.8 1.8H9"/><path d="M7.2 7v11.2A2.2 2.2 0 0 0 9.4 20.4H17"/><path d="M10.2 9.2h5M10.2 12.6h5"/>',
  person:
    '<circle cx="12" cy="8" r="3"/><path d="M5.2 19.2c1.2-3 3.6-4.6 6.8-4.6s5.6 1.6 6.8 4.6"/>',
  masks:
    '<path d="M4.8 10.2c0-2.4 2-4.4 4.5-4.4s4.4 2 4.4 4.4-2 5-4.4 5-4.5-2.6-4.5-5z"/><path d="M10.4 11c0-2.2 1.9-4 4.3-4s4.3 1.8 4.3 4-1.9 4.8-4.3 4.8-4.3-2.6-4.3-4.8z"/>',
  bolt: '<path d="M13 3.2 5.6 13h6.1L11 20.8l7.4-9.8h-6.1L13 3.2z"/>',
  map: '<path d="M9 4.8 4.2 6.6v12.6l4.8-1.8 6 1.8 4.8-1.8V4.8l-4.8 1.8-6-1.8z"/><path d="M9 4.8v12.6M15 6.6v12.6"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  file: '<path d="M7.2 3.8h6.2L19 9.4v10.8a1 1 0 0 1-1 1H7.2a1 1 0 0 1-1-1V4.8a1 1 0 0 1 1-1z"/><path d="M13.4 3.8v5.6H19"/>',
  medal: '<circle cx="12" cy="8.6" r="3.6"/><path d="M9.6 11.8 8.2 20l3.8-1.8L15.8 20l-1.4-8.2"/>',
  flag: '<path d="M6 4v16"/><path d="M6 5.2h11.2l-2.2 3.4 2.2 3.4H6"/>'
}

const { name, class: cls = 'icon' } = Astro.props
const inner = PATHS[name] ?? PATHS.file
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
