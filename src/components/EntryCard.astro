---
import {
  entryHref,
  parseEntryId,
  TYPES,
  withBase,
  asset,
  isTypeKey,
  type Entry
} from '../lib/codex'
import Art from './Art.astro'
import Icon from './Icon.astro'

interface Props {
  entry: Entry
}

const { entry } = Astro.props
const { type } = parseEntryId(entry.id)
const typeMeta = isTypeKey(type) ? TYPES[type] : undefined
const { title, emoji, summary, image, art, status, faction, role, date, tags, draft } = entry.data
const isDraft = draft && import.meta.env.DEV
const haystack = [title, summary, status, faction, role, ...tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase()

// Keep the cards short and predictable: pick the 2 most informative meta
// chips, and surface the rest as a "+N" overflow so cards stay the same
// height regardless of how richly the frontmatter is filled in.
const allMeta = [
  status && { label: status },
  role && { label: role, icon: 'medal' as const },
  faction && { label: faction, icon: 'flag' as const },
  date && { label: date, icon: 'clock' as const }
].filter(Boolean) as { label: string; icon?: string }[]
const visibleMeta = allMeta.slice(0, 2)
const overflowCount = allMeta.length - visibleMeta.length
---

<a
  class={`card${image ? ' card--has-cover' : ''}${isDraft ? ' card--draft' : ''}`}
  href={withBase(entryHref(entry))}
  data-search={haystack}
>
  <div class="card__cover-wrap">
    {
      art ? (
        <Art
          src={art}
          class="card__cover"
          alt=""
          widths={[240, 480]}
          sizes="(max-width: 860px) 90vw, 280px"
        />
      ) : image ? (
        <img class="card__cover" src={asset(image)} alt="" loading="lazy" />
      ) : emoji ? (
        <span class="card__cover-emoji" aria-hidden="true">
          {emoji}
        </span>
      ) : (
        <Icon name={typeMeta?.icon ?? 'file'} class="icon card__cover-icon" />
      )
    }
    {
      typeMeta && (
        <span class="card__type">
          <Icon name={typeMeta.icon} class="icon card__type-icon" />
          {typeMeta.singular}
        </span>
      )
    }
    {
      isDraft && (
        <span class="card__draft" title="Rascunho — só visível em desenvolvimento">
          DRAFT
        </span>
      )
    }
  </div>
  <div class="card__body">
    <h3 class="card__title">{image && (emoji ?? typeMeta?.emoji)} {title}</h3>
    {summary && <p class="card__summary">{summary}</p>}
    {
      (visibleMeta.length > 0 || overflowCount > 0) && (
        <div class="chips card__chips">
          {visibleMeta.map((m) => (
            <span class="chip">
              {m.icon && <Icon name={m.icon} class="icon chip__icon" />}
              {m.label}
            </span>
          ))}
          {overflowCount > 0 && <span class="chip chip--muted">+{overflowCount}</span>}
        </div>
      )
    }
  </div>
</a>
