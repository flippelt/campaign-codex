---
import { TYPES, TYPE_KEYS, withBase } from '../lib/codex'
import Icon from './Icon.astro'

interface Props {
  campaignId: string
  campaignName: string
  emoji: string
  counts: Record<string, number>
  active: string
}

const { campaignId, campaignName, emoji, counts, active } = Astro.props
---

<nav>
  <p class="sidebar__title">Campanha</p>
  <a
    class="navlink"
    href={withBase(`/${campaignId}/`)}
    aria-current={active === 'home' ? 'page' : undefined}
  >
    <span class="navlink__emoji">{emoji}</span>
    <span>{campaignName}</span>
  </a>

  <p class="sidebar__title" style="margin-top:18px">Conteúdo</p>
  {
    TYPE_KEYS.map((key) => (
      <a
        class="navlink"
        href={withBase(`/${campaignId}/${key}/`)}
        aria-current={active === key ? 'page' : undefined}
      >
        <Icon name={TYPES[key].icon} class="icon navlink__icon" />
        <span>{TYPES[key].label}</span>
        <span class="navlink__count">{counts[key] ?? 0}</span>
      </a>
    ))
  }

  <p class="sidebar__title" style="margin-top:18px">Explorar</p>
  <a
    class="navlink"
    href={withBase(`/${campaignId}/buscar/`)}
    aria-current={active === 'search' ? 'page' : undefined}
  >
    <Icon name="search" class="icon navlink__icon" />
    <span>Buscar</span>
  </a>
  <a
    class="navlink"
    href={withBase(`/${campaignId}/tags/`)}
    aria-current={active === 'tags' ? 'page' : undefined}
  >
    <Icon name="tag" class="icon navlink__icon" />
    <span>Tags</span>
  </a>
  <a
    class="navlink"
    href={withBase(`/${campaignId}/linha-do-tempo/`)}
    aria-current={active === 'timeline' ? 'page' : undefined}
  >
    <Icon name="clock" class="icon navlink__icon" />
    <span>Linha do Tempo</span>
  </a>
  <a class="navlink" href={withBase(`/recap/?campaign=${encodeURIComponent(campaignId)}`)}>
    <Icon name="file" class="icon navlink__icon" />
    <span>Recap</span>
  </a>
</nav>
