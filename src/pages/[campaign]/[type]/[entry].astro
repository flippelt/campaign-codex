---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import {
  getCampaigns,
  getCampaign,
  typeCounts,
  parseEntryId,
  allowedCampaignIds,
  getEntries,
  getBacklinks,
  entryHref,
  TYPES,
  withBase,
  asset,
  isTypeKey,
  tagSlug,
  type Entry,
  type TypeKey
} from '../../../lib/codex'

export async function getStaticPaths() {
  const all = await getCollection('entries')
  const allowed = await allowedCampaignIds()
  return all
    .filter((e) => import.meta.env.DEV || !e.data.draft)
    .map((e) => ({ entry: e, parts: parseEntryId(e.id) }))
    .filter(({ parts }) => allowed.has(parts.campaign))
    .map(({ entry, parts }) => ({
      params: { campaign: parts.campaign, type: parts.type, entry: parts.slug },
      props: { entry }
    }))
}

interface Props {
  entry: Entry
}
const { entry } = Astro.props
const { campaign: id, type } = parseEntryId(entry.id)
const campaign = await getCampaign(id)
if (!campaign) return Astro.redirect(withBase('/'))

const campaigns = await getCampaigns()
const counts = await typeCounts(id)
const meta = isTypeKey(type) ? TYPES[type] : undefined
const { Content, headings } = await render(entry)
const d = entry.data
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)

// Sibling entries (same campaign + type) for prev/next nav.
const siblings = isTypeKey(type) ? await getEntries(id, type as TypeKey) : []
const myIndex = siblings.findIndex((e) => e.id === entry.id)
const prev = myIndex > 0 ? siblings[myIndex - 1] : null
const next = myIndex >= 0 && myIndex < siblings.length - 1 ? siblings[myIndex + 1] : null

// Other entries that link to this one (best-effort textual scan).
const backlinks = await getBacklinks(entry)

const facts: [string, string][] = []
if (d.status) facts.push(['Status', d.status])
if (d.role) facts.push(['Papel', d.role])
if (d.faction) facts.push(['Facção', d.faction])
if (d.location) facts.push(['Local', d.location])
if (d.date) facts.push(['Data', d.date])
const hasAside =
  !!d.image || facts.length > 0 || d.tags.length > 0 || toc.length >= 3 || backlinks.length > 0
---

<BaseLayout
  title={`${d.title} · ${campaign.data.name}`}
  description={d.summary}
  theme={campaign.data.theme}
  campaigns={campaigns}
  current={id}
  ogImage={d.image}
  ogType="article"
  sidebar={{
    campaignId: id,
    campaignName: campaign.data.name,
    emoji: campaign.data.emoji,
    counts,
    active: type
  }}
>
  <p class="breadcrumb">
    <a href={withBase(`/${id}/`)}>{campaign.data.emoji} {campaign.data.name}</a> ›
    <a href={withBase(`/${id}/${type}/`)}>{meta?.label ?? type}</a> ›
    {d.title}
  </p>

  {
    d.draft && import.meta.env.DEV && (
      <div class="draft-banner" role="status">
        🚧 <strong>Rascunho</strong> — esta entrada não aparece em builds de produção.
      </div>
    )
  }

  <div class="page-head">
    <h1>{d.emoji ?? meta?.emoji ?? '📄'} {d.title}</h1>
    {d.summary && <p>{d.summary}</p>}
  </div>

  <article class={hasAside ? 'entry' : ''}>
    <div class="prose">
      <Content />
    </div>

    {
      hasAside && (
        <aside class="aside">
          {toc.length >= 3 && (
            <nav class="toc" aria-label="Sumário">
              <p class="toc__title">Nesta página</p>
              <ol class="toc__list">
                {toc.map((h) => (
                  <li class={`toc__item toc__item--d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
          {d.image && <img class="aside__img" src={asset(d.image)} alt={d.title} />}
          {facts.length > 0 && (
            <dl>
              {facts.map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))}
            </dl>
          )}
          {d.tags.length > 0 && (
            <div class="chips" style="margin-top:12px">
              {d.tags.map((t) => (
                <a class="chip chip--link" href={withBase(`/${id}/tags/${tagSlug(t)}/`)}>
                  #{t}
                </a>
              ))}
            </div>
          )}
          {backlinks.length > 0 && (
            <div class="backlinks">
              <p class="backlinks__title">Aparece em</p>
              <ul class="backlinks__list">
                {backlinks.map((b) => {
                  const bt = parseEntryId(b.id).type
                  const bm = isTypeKey(bt) ? TYPES[bt] : undefined
                  return (
                    <li>
                      <a href={withBase(entryHref(b))}>
                        {b.data.emoji ?? bm?.emoji ?? '📄'} {b.data.title}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </div>
          )}
        </aside>
      )
    }
  </article>

  {
    (prev || next) && (
      <nav class="prevnext" aria-label="Navegar entradas">
        {prev ? (
          <a
            class="prevnext__link prevnext__link--prev"
            href={withBase(entryHref(prev))}
            rel="prev"
          >
            <span class="prevnext__dir">← Anterior</span>
            <span class="prevnext__title">
              {prev.data.emoji ?? meta?.emoji ?? '📄'} {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a
            class="prevnext__link prevnext__link--next"
            href={withBase(entryHref(next))}
            rel="next"
          >
            <span class="prevnext__dir">Próxima →</span>
            <span class="prevnext__title">
              {next.data.emoji ?? meta?.emoji ?? '📄'} {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</BaseLayout>
