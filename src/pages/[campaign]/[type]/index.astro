---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EntryCard from '../../../components/EntryCard.astro'
import Icon from '../../../components/Icon.astro'
import {
  getCampaigns,
  getCampaign,
  getEntries,
  typeCounts,
  TYPE_KEYS,
  TYPES,
  withBase,
  type TypeKey
} from '../../../lib/codex'

export async function getStaticPaths() {
  const campaigns = await getCampaigns()
  return campaigns.flatMap((c) => TYPE_KEYS.map((type) => ({ params: { campaign: c.id, type } })))
}

const { campaign: id, type } = Astro.params
const campaign = await getCampaign(id!)
if (!campaign) return Astro.redirect(withBase('/'))

const typeKey = type as TypeKey
const meta = TYPES[typeKey]
const campaigns = await getCampaigns()
const counts = await typeCounts(id!)
const entries = await getEntries(id!, typeKey)
---

<BaseLayout
  title={`${meta.label} · ${campaign.data.name}`}
  theme={campaign.data.theme}
  campaigns={campaigns}
  current={id}
  sidebar={{
    campaignId: id!,
    campaignName: campaign.data.name,
    emoji: campaign.data.emoji,
    counts,
    active: typeKey
  }}
>
  <p class="breadcrumb">
    <a href={withBase(`/${id}/`)}>{campaign.data.emoji} {campaign.data.name}</a> ›
    {meta.label}
  </p>
  <div class="page-head">
    <h1><Icon name={meta.icon} /> {meta.label}</h1>
    <p>{entries.length} {entries.length === 1 ? 'entrada' : 'entradas'}</p>
  </div>

  {
    entries.length === 0 ? (
      <p class="empty">
        Nada aqui ainda. Crie{' '}
        <code>
          src/content/entries/{id}/{typeKey}/&lt;slug&gt;.md
        </code>
        .
      </p>
    ) : (
      <>
        <input
          class="filter"
          type="search"
          id="filter"
          placeholder={`Filtrar ${meta.label.toLowerCase()}…`}
          aria-label="Filtrar"
        />
        <div class={typeKey === 'maps' ? 'grid grid--gallery' : 'grid'} id="entryGrid">
          {entries.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
        <p class="empty is-hidden" id="noMatch">
          Nenhuma entrada corresponde ao filtro.
        </p>

        <script is:inline>
          {`
        const input = document.getElementById('filter')
        const cards = Array.from(document.querySelectorAll('#entryGrid .card'))
        const noMatch = document.getElementById('noMatch')
        const escRe = (s) => s.replace(/[.*+?^\${}()|[\\]\\\\]/g, '\\\\$&')
        const escHtml = (s) => s.replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]))
        // Snapshot the original (untouched) text of each highlight target,
        // so we can rebuild it cleanly on every keystroke without losing
        // text across successive edits.
        const targets = cards.flatMap((card) =>
          Array.from(card.querySelectorAll('.card__title, .card__summary'))
            .map((el) => ({ el, original: el.textContent || '' }))
        )
        const highlight = (q) => {
          if (!q) {
            for (const { el, original } of targets) el.textContent = original
            return
          }
          const re = new RegExp(escRe(q), 'gi')
          for (const { el, original } of targets) {
            el.innerHTML = escHtml(original).replace(re, (m) => '<mark>' + m + '</mark>')
          }
        }
        input?.addEventListener('input', () => {
          const q = input.value.trim()
          const ql = q.toLowerCase()
          let shown = 0
          for (const card of cards) {
            const hit = !ql || (card.dataset.search || '').includes(ql)
            card.classList.toggle('is-hidden', !hit)
            if (hit) shown++
          }
          highlight(q)
          noMatch.classList.toggle('is-hidden', shown !== 0)
        })
        `}
        </script>
      </>
    )
  }
</BaseLayout>
