---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import EntryCard from '../../../components/EntryCard.astro'
import {
  getCampaigns, getCampaign, getEntries, typeCounts,
  TYPE_KEYS, TYPES, withBase, type TypeKey
} from '../../../lib/codex'

export async function getStaticPaths() {
  const campaigns = await getCampaigns()
  return campaigns.flatMap((c) => TYPE_KEYS.map((type) => ({ params: { campaign: c.id, type } })))
}

const { campaign: id, type } = Astro.params
const campaign = await getCampaign(id!)
if (!campaign) return Astro.redirect(withBase('/'))

const typeKey = type as TypeKey
const meta = TYPES[typeKey]
const campaigns = await getCampaigns()
const counts = await typeCounts(id!)
const entries = await getEntries(id!, typeKey)
---

<BaseLayout
  title={`${meta.label} · ${campaign.data.name}`}
  theme={campaign.data.theme}
  campaigns={campaigns}
  current={id}
  sidebar={{ campaignId: id!, campaignName: campaign.data.name, emoji: campaign.data.emoji, counts, active: typeKey }}
>
  <p class="breadcrumb">
    <a href={withBase(`/${id}/`)}>{campaign.data.emoji} {campaign.data.name}</a> ›
    {meta.label}
  </p>
  <div class="page-head">
    <h1>{meta.emoji} {meta.label}</h1>
    <p>{entries.length} {entries.length === 1 ? 'entrada' : 'entradas'}</p>
  </div>

  {entries.length === 0 ? (
    <p class="empty">
      Nada aqui ainda. Crie <code>src/content/entries/{id}/{typeKey}/&lt;slug&gt;.md</code>.
    </p>
  ) : (
    <>
      <input
        class="filter"
        type="search"
        id="filter"
        placeholder={`🔎 filtrar ${meta.label.toLowerCase()}…`}
        aria-label="Filtrar"
      />
      <div class="grid" id="entryGrid">
        {entries.map((entry) => <EntryCard entry={entry} />)}
      </div>
      <p class="empty is-hidden" id="noMatch">Nenhuma entrada corresponde ao filtro.</p>

      <script is:inline>
        {`
        const input = document.getElementById('filter')
        const cards = Array.from(document.querySelectorAll('#entryGrid .card'))
        const noMatch = document.getElementById('noMatch')
        input?.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase()
          let shown = 0
          for (const card of cards) {
            const hit = !q || (card.dataset.search || '').includes(q)
            card.classList.toggle('is-hidden', !hit)
            if (hit) shown++
          }
          noMatch.classList.toggle('is-hidden', shown !== 0)
        })
        `}
      </script>
    </>
  )}
</BaseLayout>
