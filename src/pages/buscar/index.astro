---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
import { getCampaigns, withBase } from '../../lib/codex'

const campaigns = await getCampaigns()
const indexUrl = withBase('/search.json')
---

<BaseLayout title="Buscar · Campaign Codex" campaigns={campaigns}>
  <div class="page-head">
    <h1><Icon name="search" /> Buscar em todas as campanhas</h1>
    <p>
      Pesquise em todas as suas campanhas. <kbd>Ctrl</kbd>/<kbd>⌘</kbd>+<kbd>K</kbd> abre esta página
      de qualquer lugar.
    </p>
  </div>

  <input
    class="filter"
    type="search"
    id="searchInput"
    placeholder="Digite ao menos 2 caracteres…"
    autocomplete="off"
    autofocus
  />
  <p class="search-status" id="searchStatus" aria-live="polite"></p>
  <ul class="search-results" id="searchResults"></ul>

  <script is:inline define:vars={{ indexUrl }}>
    const input = document.getElementById('searchInput')
    const list = document.getElementById('searchResults')
    const status = document.getElementById('searchStatus')
    let data = null
    let loading = null

    const escapeHtml = (s) =>
      s.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
      )
    const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    const highlight = (text, q) => {
      const safe = escapeHtml(text)
      if (!q) return safe
      return safe.replace(new RegExp(escapeRe(q), 'gi'), '<mark>$&</mark>')
    }
    const snippet = (body, q) => {
      if (!body) return ''
      const i = body.toLowerCase().indexOf(q.toLowerCase())
      if (i < 0) return ''
      const start = Math.max(0, i - 60)
      const end = Math.min(body.length, i + q.length + 100)
      return (start > 0 ? '…' : '') + body.slice(start, end) + (end < body.length ? '…' : '')
    }

    const load = () =>
      (loading ??= fetch(indexUrl)
        .then((r) => r.json())
        .then((j) => (data = j.items)))

    const render = (q) => {
      if (q.length < 2) {
        list.innerHTML = ''
        status.textContent = ''
        return
      }
      const ql = q.toLowerCase()
      const hits = data
        .map((it) => {
          const inTitle = it.title.toLowerCase().includes(ql)
          const inSummary = it.summary.toLowerCase().includes(ql)
          const inTags = it.tags.some((t) => t.toLowerCase().includes(ql))
          const inBody = it.body.toLowerCase().includes(ql)
          if (!inTitle && !inSummary && !inTags && !inBody) return null
          const score =
            (inTitle ? 8 : 0) + (inTags ? 4 : 0) + (inSummary ? 2 : 0) + (inBody ? 1 : 0)
          return { it, score, snip: !inTitle && !inSummary ? snippet(it.body, q) : '' }
        })
        .filter(Boolean)
        .sort((a, b) => b.score - a.score)
        .slice(0, 50)

      status.textContent =
        hits.length === 0
          ? 'Nada encontrado.'
          : `${hits.length} resultado${hits.length === 1 ? '' : 's'}${hits.length === 50 ? ' (mostrando os 50 melhores)' : ''}`

      list.innerHTML = hits
        .map(
          ({ it, snip }) => `
        <li class="search-hit">
          <a class="search-hit__link" href="${it.href}">
            <div class="search-hit__head">
              <span class="search-hit__emoji">${escapeHtml(it.emoji)}</span>
              <span class="search-hit__title">${highlight(it.title, q)}</span>
              <span class="chip chip--accent">${escapeHtml(it.campaignEmoji)} ${escapeHtml(it.campaignName)}</span>
              <span class="chip">${escapeHtml(it.typeEmoji)} ${escapeHtml(it.typeLabel)}</span>
            </div>
            ${it.summary ? `<p class="search-hit__summary">${highlight(it.summary, q)}</p>` : ''}
            ${snip ? `<p class="search-hit__snippet">${highlight(snip, q)}</p>` : ''}
            ${it.tags.length ? `<div class="search-hit__tags">${it.tags.map((t) => `<span class="chip">#${highlight(t, q)}</span>`).join('')}</div>` : ''}
          </a>
        </li>
      `
        )
        .join('')
    }

    input.addEventListener('input', async () => {
      const q = input.value.trim()
      if (q.length < 2) {
        render(q)
        return
      }
      if (!data) {
        status.textContent = 'Carregando…'
        await load()
      }
      render(q)
    })
  </script>
</BaseLayout>
